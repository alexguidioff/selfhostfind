# --- Database ---
# Used directly by Prisma when running locally (pnpm dev, pnpm prisma:*).
DATABASE_URL="postgresql://selfhostfind:changeme@localhost:5432/selfhostfind"

# Used by docker-compose.yml to build the DATABASE_URL for the `db` service.
POSTGRES_USER=selfhostfind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=selfhostfind

# --- GitHub API ---
# A classic or fine-grained PAT with public-repo read access is enough. Unauthenticated
# requests are limited to 60/hour and will make discovery impractically slow — set this.
GITHUB_TOKEN=

# --- Admin panel ---
ADMIN_PASSWORD=changeme
# Any long random string, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# --- Discovery pipeline tuning ---
DISCOVERY_MAX_PAGES_PER_QUERY=2
DISCOVERY_CONCURRENCY=3

# --- Reconcile job tuning (see README "Keeping the catalog honest") ---
# How many repository-by-ID lookups run in parallel against GitHub.
RECONCILE_CONCURRENCY=5
# Scan audit rows older than this are pruned each reconcile run, so that table doesn't grow
# forever. Doesn't affect Repository/Application data — only the per-run audit trail.
SCAN_RETENTION_DAYS=90

# Minimum classification confidence (0-1) required, alongside concrete evidence (license,
# Docker/Compose detected, non-empty README, resolved category, recent activity), before an
# app is auto-promoted from Unverified to Auto-verified without human review.
AUTO_VERIFY_CONFIDENCE_THRESHOLD=0.75

# --- Optional: HTTP-triggered cron (POST /api/cron/discover with this bearer token) ---
CRON_SECRET=

# --- Optional: operational alerting (see README "Alerting" section) ---
# Webhook that receives a push notification when the discovery/snapshot jobs crash, when a
# run has an abnormally high per-repo failure rate, or when some (but not all) search
# queries fail. Works with a self-hosted ntfy instance, ntfy.sh, Slack/Mattermost/Rocket.Chat
# incoming webhooks, Discord webhooks, or a generic JSON receiver.
ALERT_WEBHOOK_URL=
# One of: ntfy | slack | discord | generic (default: generic)
ALERT_WEBHOOK_FORMAT=generic

# Dead-man's-switch: pinged on every *successful* discover/snapshot run. Point this at a
# healthchecks.io check, an Uptime Kuma push monitor, or Cronitor — configure its grace
# period slightly longer than your cron interval, and it will alert you if the job (or the
# whole host) silently stops running, which a webhook alert from inside the job cannot catch.
HEARTBEAT_URL=

# --- Optional: database backups (see README "Backups") ---
BACKUP_RETENTION_DAYS=14
# Separate from HEARTBEAT_URL so a backup that silently stops running (different schedule,
# different failure modes) is distinguishable from the discovery pipeline stopping.
BACKUP_HEARTBEAT_URL=

PORT=3000
