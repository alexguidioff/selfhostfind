{
  "name": "selfhosted-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "discover": "tsx --env-file-if-exists=.env src/pipeline/discover.ts",
    "refresh": "tsx --env-file-if-exists=.env src/pipeline/refresh.ts",
    "reconcile": "tsx --env-file-if-exists=.env src/pipeline/reconcile.ts",
    "snapshot": "tsx --env-file-if-exists=.env src/pipeline/snapshot.ts",
    "reclassify": "tsx --env-file-if-exists=.env src/pipeline/reclassify.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "overrides": {
      "next@15>postcss": "$postcss"
    }
  }
}
